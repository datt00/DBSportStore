@using System.Linq
@model DBSportStore.Models.StoreHomeViewModel

@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<section class="hero">
    <div>
        <p>NEW SEASON / SPORT & ACTIVE</p>
        <h1>Move better. Train stronger.</h1>
        <p>Khám phá bộ sưu tập thể thao dành cho tập luyện, thi đấu và phong cách sống năng động.</p>
        <a class="btn-brand" href="#featured-products">Mua sắm ngay</a>
    </div>
</section>

<h2 class="section-title">Tất cả sản phẩm</h2>
<p class="result-count">
    Tìm thấy @Model.TotalItems sản phẩm
</p>

<div class="store-shell" id="featured-products">

    <aside class="category-panel">
        <h3>Danh mục</h3>

        <ul class="category-list">
            <li>
                <a href="@Url.Action("Index", "Store")">
                    Tất cả sản phẩm
                </a>
            </li>

            @foreach (var category in Model.Categories)
            {
                <li>
                    <a class="@(Model.SelectedCategoryId == category.CategoryID ? "category-active" : "")"
                       href="@Url.Action("Index", "Store", new {
                           categoryId = category.CategoryID,
                           keyword = Model.SearchTerm,
                           minPrice = Model.MinPrice,
                           maxPrice = Model.MaxPrice,
                           sortOrder = Request.QueryString["sortOrder"]
                       })">
                        @category.CategoryName
                    </a>
                </li>
            }
        </ul>
    </aside>

    <main class="store-content">

        <div class="catalog-toolbar">
            @using (Html.BeginForm("Index", "Store", FormMethod.Get,
                new { @class = "catalog-search" }))
            {
                if (Model.SelectedCategoryId.HasValue)
                {
                    <input type="hidden"
                           name="categoryId"
                           value="@Model.SelectedCategoryId" />
                }

                <input type="text"
                       name="keyword"
                       value="@Model.SearchTerm"
                       placeholder="Tìm tên hoặc mô tả sản phẩm..." />

                <input type="number"
                       name="minPrice"
                       value="@Model.MinPrice"
                       min="0"
                       step="1000"
                       placeholder="Giá từ" />

                <input type="number"
                       name="maxPrice"
                       value="@Model.MaxPrice"
                       min="0"
                       step="1000"
                       placeholder="Giá đến" />
                <select name="sortOrder">
                    <option value="">Mặc định</option>
                    <option value="price_asc"
                            @(Request.QueryString["sortOrder"] == "price_asc" ? "selected" : "")>
                        Giá thấp đến cao
                    </option>
                    <option value="price_desc"
                            @(Request.QueryString["sortOrder"] == "price_desc" ? "selected" : "")>
                        Giá cao đến thấp
                    </option>
                </select>
                <button type="submit" class="btn-brand">
                    Tìm kiếm
                </button>

                <a class="btn-soft" href="@Url.Action("Index", "Store")">
                    Xóa lọc
                </a>
            }
        </div>
        <section>
            @* ===== DANH SÁCH SẢN PHẨM ===== *@
            @* Kiểm tra danh sách Products có sản phẩm hay không *@
            @if (Model.Products != null && Model.Products.Count > 0)
            {
                @* Có sản phẩm → hiển thị danh sách sản phẩm *@
                <div class="product-grid">

                    @foreach (var item in Model.Products)
                    {
                        <article class="product-card">

                            <div class="product-image">
                                @* Hiển thị ảnh sản phẩm từ Content/images *@
                                <img src="~/Content/images/@item.ImagePro"
                                     alt="@item.NamePro" />

                            </div>

                            <div class="product-body">

                                @* Tên danh mục của sản phẩm *@
                                <div style="color:#64748b;font-size:13px;">
                                    @item.CategoryName
                                </div>
                                @* Tên sản phẩm *@
                                <div class="product-name">
                                    @item.NamePro
                                </div>
                                @* Mô tả ngắn sản phẩm *@
                                <div class="product-description">
                                    @item.ShortDescription
                                </div>
                                @* Đơn giá, định dạng có dấu phân cách hàng nghìn *@
                                <div class="product-price">
                                    @item.Price.ToString("#,##0") đ
                                </div>
                                <div class="product-actions">
                                    @* Chức năng Chi tiết *@
                                    @Html.ActionLink(
                                        "Chi tiết",                  // Chữ hiển thị
                                        "Details",                   // Action Details
                                        "Products",                  // ProductsController
                                        new { id = item.ProductID }, // Gửi ProductID của sản phẩm đang xem
                                        new { @class = "btn-soft" }  // Giữ nguyên CSS
                                        )


                                    @* B07 mới thực hiện chức năng Giỏ hàng *@
                                    <a class="btn-brand" href="#">
                                        Mua
                                    </a>


                                </div>
                            </div>
                        </article>
                    }

                </div>
            }
            else
            {
                @* Không có sản phẩm phù hợp sau khi lọc hoặc tìm kiếm *@
                <div class="catalog-empty">

                    <h3>Không tìm thấy sản phẩm phù hợp</h3>

                    <p>
                        Không có sản phẩm nào phù hợp với
                        các điều kiện lọc hoặc từ khóa đang chọn.
                    </p>

                    @* Quay về Trang Chủ và xóa toàn bộ điều kiện lọc / tìm kiếm *@
                    <a class="btn-brand"
                       href="@Url.Action("Index", "Store")">
                        Xem tất cả sản phẩm
                    </a>

                </div>
            }
            @* ==================== PHÂN TRANG ==================== *@
            @if (Model.TotalPages > 1)
            {
                <div class="store-pagination">

                    @* Nút quay về trang trước *@
                    @if (Model.CurrentPage > 1)
                    {
                        <a href="@Url.Action(
                        "Index",
                        "Store",
                        new
                        {
                            categoryId = Model.SelectedCategoryId,
                            minPrice = Model.MinPrice,
                            maxPrice = Model.MaxPrice,
                            keyword = Model.SearchTerm,
                            //Sắp xếp theo giá 
                            sortOrder = Request.QueryString["sortOrder"],

                            page = Model.CurrentPage - 1
                        })">
                            ← Trước
                        </a>
                    }

                    @* Hiển thị các số trang *@
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == Model.CurrentPage)
                        {
                            @* Trang hiện tại không cần tạo link *@
                            <span class="active">@i</span>
                        }
                        else
                        {
                            <a href="@Url.Action(
                            "Index",
                            "Store",
                            new
                            {
                                categoryId = Model.SelectedCategoryId,
                                keyword = Model.SearchTerm,
                                // MỚI: giữ Price Filter khi chuyển trang.
                                minPrice = Model.MinPrice,
                                maxPrice = Model.MaxPrice,
                                //Sắp xếp theo giá 
                                sortOrder = Request.QueryString["sortOrder"],

                                page = i
                            })">
                                @i
                            </a>
                        }
                    }

                    @* Nút sang trang kế tiếp *@
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a href="@Url.Action(
                        "Index",
                        "Store",
                        new
                        {
                            categoryId = Model.SelectedCategoryId,
                            keyword = Model.SearchTerm,
                            // MỚI: giữ Price Filter khi chuyển trang.
                            minPrice = Model.MinPrice,
                            maxPrice = Model.MaxPrice,
                            sortOrder = Request.QueryString["sortOrder"],

                            page = Model.CurrentPage + 1
                        })">
                            Sau →
                        </a>
                    }

                </div>
            }

        </section>
        

    </main>

</div>