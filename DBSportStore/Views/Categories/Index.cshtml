@model IEnumerable<DBSportStore.Models.Category>

@{
    ViewBag.Title = "Quản lý danh mục";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<h2>QUẢN LÝ DANH MỤC</h2>

<p>
    @Html.ActionLink("Thêm danh mục mới", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.CategoryName)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.CategoryName)
        </td>
        <td>
            @Html.ActionLink("Sửa danh mục", "Edit", new { id=item.CategoryID }) |
            @Html.ActionLink("Chi tiết danh mục", "Details", new { id=item.CategoryID }) |
            @Html.ActionLink("Xóa danh mục", "Delete", new { id=item.CategoryID })
        </td>
    </tr>
}

</table>
